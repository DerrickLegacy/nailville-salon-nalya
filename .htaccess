# # --- Laravel Routing (including POST/PUT/DELETE fix) ---
# <IfModule mod_rewrite.c>
#     RewriteEngine On

#     # Prevent blocking of POST/PUT/DELETE
#     RewriteCond %{REQUEST_METHOD} ^(POST|PUT|DELETE)$
#     RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},L]

#     # Map asset directories to /public/ (because root ≠ public)
#     RewriteCond %{REQUEST_URI} ^/(build|css|js|images|fonts)/
#     RewriteRule ^(.*)$ public/$1 [L]

#     # If file or directory does not exist, send to Laravel
#     RewriteCond %{REQUEST_FILENAME} !-f
#     RewriteCond %{REQUEST_FILENAME} !-d
#     RewriteRule ^ public/index.php [L]
# </IfModule>


<IfModule mod_rewrite.c>
RewriteEngine On

# Map common asset directories to /public/
RewriteCond %{REQUEST_URI} ^/(build|css|js|images|fonts)/
RewriteRule ^(.*)$ public/$1 [L]

# Send everything else to Laravel inside /public
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [L]
</IfModule>
